CODEMIND_ENGINE_ENDPOINT=127.0.0.1:50051

# Required for model-backed investigations. Keep credentials local.
OPENROUTER_API_KEY=
CODEMIND_LLM_MODEL=openrouter/free

# Replace this development-only placeholder with a locally generated secret.
CODEMIND_SESSION_SECRET=replace-with-a-long-random-secret

# Optional local-only signed-session bootstrap. Disabled by default and rejected in production.
CODEMIND_DEV_AUTH_ENABLED=false
CODEMIND_DEV_USER_ID=local-developer
CODEMIND_DEV_WORKSPACE_ID=local-workspace
CODEMIND_DEV_SCOPES=user,repository
CODEMIND_DEV_TEAM_IDS=

# Trusted local repository registrations. Each entry needs sourcePath and workspaceId;
# the Rust RepositoryService resolves source identity and snapshot state.
CODEMIND_REPOSITORIES_JSON=[]

# Imported public GitHub repositories are cloned here and indexed by workspace.
# Keep this directory private and outside the public web root.
CODEMIND_REPOSITORY_STORAGE_ROOT=./.codemind/repositories

# Optional GitHub token for private repositories and authenticated API limits.
# Leave blank in source control; add the real token only to your local .env file.
CODEMIND_GITHUB_TOKEN=

# FalkorDB used by Level 2/3 persistence and pipeline tests.
FALKORDB_URL=redis://127.0.0.1:6380
